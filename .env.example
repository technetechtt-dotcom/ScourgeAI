# Replace with random independent high-entropy secrets; never commit .env.
TIC_CLIENT_SECRETS={"demo:guardian":"replace-with-a-long-random-guardian-secret","demo:arxvigil":"replace-with-a-long-random-arx-secret"}
# Optional device HMAC keys. Secret material stays here, not in the database.
# TIC_DEVICE_KEYS={"tracker-1":{"secret":"replace-me","tenant_id":"demo","product":"arxvigil"}}
DATABASE_URL=sqlite:///./techne.db
# PostgreSQL example:
# DATABASE_URL=postgresql+psycopg://techne:techne@localhost:5432/techne
DB_POOL_SIZE=5
DB_MAX_OVERFLOW=10
DB_POOL_TIMEOUT=30
TIC_RATE_LIMIT=600
TIC_RATE_WINDOW=60
TIC_MFA_ISSUER=ScourgeAI
TIC_WORKER=0
TIC_WORKER_INTERVAL=5
TIC_ENV=development
# Production startup rejects placeholder client secrets, a missing TIC_DATA_KEY, and unsigned telemetry.
# TIC_REQUIRE_DEVICE_SIGNATURE=1
# Required when TIC_ENV=production. In development a local .tic_data_key file is created if this is empty.
# TIC_DATA_KEY=replace-with-a-long-random-value
# Optional OIDC bearer tokens (HS256). Leave unset to keep session tokens only.
# TIC_OIDC_HMAC_SECRET=
# TIC_OIDC_ISSUER=https://idp.example
# TIC_OIDC_AUDIENCE=scourgeai
# Require a TLS client certificate on /v1. Health checks stay open.
TIC_MTLS_REQUIRED=0
TIC_WORKER_COUNT=1
